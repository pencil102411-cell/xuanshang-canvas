{
  "_说明": "Claude Code 权限建议：只读工具直接放行，花积分的两个工具每次都询问。把 permissions 里的内容合并到 ~/.claude/settings.json 的 permissions 下。用插件安装时用 plugin 这组名字；用 claude mcp add 手动注册时用 manual 这组名字。",
  "plugin": {
    "permissions": {
      "allow": [
        "mcp__plugin_xuanshang-canvas_xuanshang-canvas__canvas_status",
        "mcp__plugin_xuanshang-canvas_xuanshang-canvas__list_projects",
        "mcp__plugin_xuanshang-canvas_xuanshang-canvas__get_graph_summary",
        "mcp__plugin_xuanshang-canvas_xuanshang-canvas__list_certified_groups",
        "mcp__plugin_xuanshang-canvas_xuanshang-canvas__get_task"
      ],
      "ask": [
        "mcp__plugin_xuanshang-canvas_xuanshang-canvas__submit_generation",
        "mcp__plugin_xuanshang-canvas_xuanshang-canvas__create_final_video"
      ]
    }
  },
  "manual": {
    "permissions": {
      "allow": [
        "mcp__xuanshang-canvas__canvas_status",
        "mcp__xuanshang-canvas__list_projects",
        "mcp__xuanshang-canvas__get_graph_summary",
        "mcp__xuanshang-canvas__list_certified_groups",
        "mcp__xuanshang-canvas__get_task"
      ],
      "ask": [
        "mcp__xuanshang-canvas__submit_generation",
        "mcp__xuanshang-canvas__create_final_video"
      ]
    }
  }
}
